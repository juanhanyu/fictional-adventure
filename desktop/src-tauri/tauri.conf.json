{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "转生千金～到了异世界就要悠闲地生活",
  "mainBinaryName": "vesteria-desktop",
  "version": "1.0.0",
  "identifier": "com.vesteria.fictionaladventure",
  "build": {
    "beforeDevCommand": "node scripts/prepare-dist.mjs",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "转生千金～到了异世界就要悠闲地生活",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#FAFBFD",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "House of Vesteria",
    "copyright": "Copyright © House of Vesteria",
    "category": "Game",
    "shortDescription": "转生千金～到了异世界就要悠闲地生活",
    "longDescription": "日式西幻视觉小说与策略养成独立游戏《转生千金～到了异世界就要悠闲地生活》桌面正式版。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
