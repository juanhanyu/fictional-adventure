{
  "schemaVersion": "1.0.0",
  "project": "转生千金～到了异世界就要悠闲地生活",
  "purpose": "全链路日语配音选角 SSOT（25 套零撞车 Fish Audio 日语模型 + 角色别名映射 + voiceId/路径契约 + 战斗语音点位表）",
  "ssotContract": {
    "normalization": "CRLF->LF, replace /[\\u3000\\s]+/g with single ASCII space, trim",
    "hashAlgorithm": "FNV-1a 32-bit unsigned lowercase 8-char hex (offset 0x811c9dc5, prime 0x01000193)",
    "hashInput": "${charId}|${normalizeVoiceText(text)}",
    "voiceIdPatterns": {
      "story": "${sceneId}__${charId}__${fnv1aHex(charId + '|' + normalizeVoiceText(text))}",
      "mono": "${sceneId}__${charId}__${fnv1aHex(charId + '|' + normalizeVoiceText(text))}",
      "combat": "combat__${cueKey}",
      "interactive": "inter__${kind}__${charId}__${fnv1aHex(charId + '|' + normalizeVoiceText(text))}"
    },
    "audioPathPatterns": {
      "story": "assets/voice/story/${sceneId}/${voiceId}.mp3",
      "mono": "assets/voice/story/${sceneId}/${voiceId}.mp3",
      "combat": "assets/voice/combat/${voiceId}.mp3",
      "interactive": "assets/voice/interactive/${kind}/${voiceId}.mp3"
    },
    "interactiveKinds": [
      "tap",
      "gift",
      "roam_greet",
      "roam_talk",
      "branch"
    ],
    "skipLineRegex": "^（[\\s\\S]*）$",
    "roamGreetContract": "roamGreetingText(charId, locId) appends ROAM_PLACE_DETAIL[locId] (or '<locName>今天很安静。' / '这里今天很安静。'); voiceId hashes ONLY the character's spoken greeting prefix before detail.",
    "speakerResolutionOrder": [
      "1. If text matches /^（[\\s\\S]*）$/, skip (pure stage action / choice prompt, not spoken).",
      "2. If speaker === '家庭教师', force charId = 'teacher' (overrides ch: 'lecturer' in s_sisters_grow).",
      "3. If speaker === '霁清', inspect active portrait id or ch: if 'ji' (adult proposal in s_eye_of_storm), return 'ji'; else 'jiqing'.",
      "4. If speaker matches /^[？?]+$/, resolve via ch -> active portrait id -> scene context (s_start: sophia/claude, s_yaoshen: yaoshen).",
      "5. Look up trimmed speaker in speakerAliases.",
      "6. Fall back to ch (if valid), then active portrait id (portraits.find(p => p && p.active !== false)?.id)."
    ]
  },
