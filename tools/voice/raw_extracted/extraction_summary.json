  "skippedParenthesized": [
    {
      "scope": "mainline",
      "sceneId": "s_start",
      "lineIdx": "40",
      "speaker": "？？？",
      "ch": "sophia",
      "zh_text": "（抱着我的那个女人还在轻声说话。我听不懂语言，但从语调判断，她应该很开心。）"
    },
    {
      "scope": "mainline",
      "sceneId": "s_start",
      "lineIdx": "41",
      "speaker": "？？？",
      "ch": "claude",
      "zh_text": "（低沉而稳重的男声。语气里有明显的颤抖，像是怕弄坏什么易碎的东西。）"
    },
    {
      "scope": "mainline",
      "sceneId": "s_turnpoint",
      "lineIdx": "9",
      "speaker": "索菲亚",
      "ch": "sophia",
      "zh_text": "（白色法杖。霜杉木簪。看了我一眼。点头。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_alice_shade",
      "lineIdx": "4",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（午后的风吹动窗边树影，要怎么回答爱丽丝？）"
    },
    {
      "scope": "branch",
      "sceneId": "v_alice_shade_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（她低头看着那枚干叶书签，像在等一个能写进心底的答案。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_beatrice_practice",
      "lineIdx": "4",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（姐姐藏在背后的手指还在微微发烫。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_beatrice_practice_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（火光映在她认真的蓝眼睛里，平日的咋呼气全收了起来。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_noelle_clocktower",
      "lineIdx": "4",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（橘猫仰头喵了一声，诺艾儿的鼻尖被高处冷风吹得发红。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_noelle_clocktower_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（她手指悬在猫耳朵上方不远处，认真得像在拆解高阶术式。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_aino_flowerhouse",
      "lineIdx": "5",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（原来极北之地长大的人，连舌头也是怕烫的。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_aino_flowerhouse_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（往日她只点出差错从不亲手演示——眼前这一遍，是离开前郑重的预演。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_charlotte_memorial",
      "lineIdx": "4",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（积水正顺着她刚挖好的浅沟绕开两边树根流向低处。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_charlotte_memorial_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（王后母族贝尔蒙家私军换防的细节从她话音里漏出一角。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_helena_corridor",
      "lineIdx": "4",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（晚霞映在她垂下的绿眸里，难得卸下了小太阳般的坚强。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_helena_corridor_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（她双手合十望着我，金发镀着最后一抹暮光。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_ajun_kitchen",
      "lineIdx": "4",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（研究药物适配，为什么会问到王室纹章银杯、客房朝向与夜巡换班？）"
    },
    {
      "scope": "branch",
      "sceneId": "v_ajun_kitchen_r2",
      "lineIdx": "2",
      "speaker": "希尔维亚",
      "ch": null,
      "zh_text": "（巴依使团冬假访府、旧纹章银杯、侧门与换班……有人正借使团之手拼凑公爵府的布防图！）"
    },
    {
      "scope": "branch",
      "sceneId": "v_jilan_night",
      "lineIdx": "4",
      "speaker": "渔",
      "ch": null,
      "zh_text": "（夜风吹动她发间亮紫色的蝴蝶发饰，白日里两倍速的大嗓门轻得像叹息。）"
    },
    {
      "scope": "branch",
      "sceneId": "v_jilan_night_r2",
      "lineIdx": "2",
      "speaker": "渔",
      "ch": null,
      "zh_text": "（走廊门框上旧名牌留下的钉孔在月光下清晰可见。）"
    }
  ],
